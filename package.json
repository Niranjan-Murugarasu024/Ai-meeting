{
  "name": "ai-meeting-intelligence",
  "version": "1.0.0",
  "description": "AI Meeting - Meeting Intelligence: Transcription, Summarization, Action Extraction & Search",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"FASTAPI,CLIENT\" -c \"yellow,cyan\" \"npm run server:py\" \"npm run client:dev\"",
    "server:py": "python -m uvicorn backend.main:app --reload --port 8000",
    "server:dev": "tsx watch server/index.ts",
    "client:dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "python -m uvicorn backend.main:app --port 8000"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
